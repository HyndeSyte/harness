// For the bun check's step that fails on names and imports that don't resolve
// (.github/workflows/tests.yml): Bun runs TypeScript without checking it, so a misspelled
// name crashes only at run time. Type nits aren't gated.
{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["bun"],
    "typeRoots": ["/tmp/tscheck/node_modules/@types"],
    "lib": ["esnext", "dom"]
  },
  "include": ["rootfs/opt/cain/**/*.ts", "tests/**/*.ts"]
}
