#!/bin/bash
# Runs a command as the rollback watcher's own user, watch (Cain 0.14.0): not Cain's, not root.
# Like as-cain: no capabilities, no way to gain any, at most 64 processes, and none of root's
# environment beyond a fixed few, so the Supervisor's token, the App's keys and the heartbeat URLs
# never reach it. Its group reads the probe's records (/data/probe); it writes only its own folder
# (/data/watcher). Root's helper reads its requests through here too, so no link of its leads root.
#   as-watch <command> [args...]
set -eu
cd /data/watcher 2>/dev/null || cd /
exec prlimit --nproc=64:64 setpriv --reuid=watch --regid=watch --init-groups --no-new-privs --inh-caps=-all --bounding-set=-all \
  env -i HOME=/data/watcher TMPDIR=/data/watcher USER=watch LOGNAME=watch \
    PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ="${TZ:-America/New_York}" \
    "$@"
