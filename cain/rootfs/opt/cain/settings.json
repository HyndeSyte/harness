  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "disableSideloadFlags": true,
  "strictPluginOnlyCustomization": ["mcp", "hooks"],
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [
    { "serverCommand": ["/usr/local/bin/bun", "/opt/cain/discord/bridge.ts"] },
    { "serverUrl": "https://*" }
  ],
  "strictKnownMarketplaces": [
    { "source": "github", "repo": "anthropics/claude-plugins-official" }
  ],
  "enabledPlugins": {
    "discord@claude-plugins-official": true
  },
  "syncClaudeAiPlugins": false,
  "skillOverrides": { "auto-mode-setup": "off" },
  "promptSuggestionEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "RemoteTrigger",
        "hooks": [
          { "type": "command", "command": "bun /opt/cain/hooks/remote-trigger.ts || exit 2", "timeout": 15, "onFailure": "block" }
        ]
      }
    ]
  }
