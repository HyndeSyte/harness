{
  "permissions": {
    "allow": [
      "Bash(/opt/cain/keeper.sh)",
      "Bash(/opt/cain/keeper.sh:*)",
      "Bash(/opt/cain/handover.sh)",
      "Bash(/opt/cain/handover.sh:*)",
      "Bash(/opt/cain/record.sh)",
      "Bash(/opt/cain/record.sh:*)",
      "Bash(/opt/cain/review.sh)",
      "Bash(/opt/cain/review.sh:*)",
      "mcp__plugin_discord_discord__download_attachment",
      "mcp__plugin_discord_discord__fetch_messages"
    ],
    "deny": [
      "mcp__claude_ai_Google_Calendar__create_event",
      "mcp__claude_ai_Google_Calendar__update_event",
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__claude_ai_Google_Calendar__respond_to_event",
      "mcp__claude_ai_Notion__notion-calendar-create-events",
      "mcp__claude_ai_Notion__notion-calendar-update-events",
      "mcp__claude_ai_Notion__notion-calendar-cancel-events",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_HASS_MCP",
      "mcp__claude_ai_GitHub__create_or_update_file",
      "mcp__claude_ai_GitHub__push_files",
      "mcp__claude_ai_GitHub__delete_file",
      "mcp__claude_ai_GitHub__create_branch",
      "mcp__claude_ai_GitHub__merge_pull_request",
      "Read(//data/options.json)",
      "Read(//data/link/**)",
      "Edit(//data/link/**)",
      "Edit(//data/trust/**)",
      "Read(//data/codex/**)",
      "Edit(//data/codex/**)",
      "Edit(//data/review-queue/**)",
      "Edit(//data/review-spend.json)",
      "Edit(//data/record-holds.json)",
      "Edit(//data/record-holds.json.next)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "RemoteTrigger",
        "hooks": [
          { "type": "command", "command": "bun /opt/cain/hooks/remote-trigger.ts || exit 2", "timeout": 15, "onFailure": "block" }
        ]
      },
      {
        "matcher": "mcp__plugin_discord_discord__download_attachment",
        "hooks": [
          { "type": "command", "command": "bun /opt/cain/hooks/discord-read.ts || exit 2", "timeout": 15, "onFailure": "block" }
        ]
      },
      {
        "matcher": "mcp__plugin_discord_discord__fetch_messages",
        "hooks": [
          { "type": "command", "command": "bun /opt/cain/hooks/discord-read.ts || exit 2", "timeout": 15, "onFailure": "block" }
        ]
      },
      {
        "matcher": "mcp__plugin_discord_discord__reply",
        "hooks": [
          { "type": "command", "command": "bun /opt/cain/hooks/discord-send.ts || true", "timeout": 5 }
        ]
      },
      {
        "matcher": "mcp__plugin_discord_discord__edit_message",
        "hooks": [
          { "type": "command", "command": "bun /opt/cain/hooks/discord-send.ts || true", "timeout": 5 }
        ]
      }
    ]
  }
}
