#!/usr/bin/with-contenv bashio
# ==============================================================================
# The terminal page: ttyd on localhost only, behind nginx, which admits only
# Home Assistant's Ingress proxy. It attaches to the running session.
# ==============================================================================
export HOME=/data TERM=xterm-256color LANG=C.UTF-8 LC_ALL=C.UTF-8
# Supervisor's token stays out of what starts here, as in cain/run. bashio keeps its
# own unexported copy, so the option read below still works.
unset SUPERVISOR_TOKEN HASSIO_TOKEN
# And of Ingress's requests, only the owner's: the Home Assistant user set as
# owner_user_id. nginx.conf includes the map written here; with no valid id,
# nobody gets in. If it can't be written, the old one goes too, so nginx won't start.
bashio::app.config >/dev/null 2>&1 \
  || bashio::log.error "Couldn't read this App's options from Supervisor; the panel stays closed until the next start"
owner="$(bashio::config 'owner_user_id' 2>/dev/null || true)"
[ "$owner" = "null" ] && owner=""
if said="$(/opt/cain/owner-gate.sh "$owner" /etc/nginx/owner.conf)"; then
  bashio::log.info "$said"
else
  rm -f /etc/nginx/owner.conf
  bashio::log.error "Could not write /etc/nginx/owner.conf, so Cain's panel stays closed"
fi
# Hygiene: s6's copy of the container's environment, the token included, root only.
chmod 0700 /run/s6/container_environment 2>/dev/null || true
# The upstreams nginx proxies to are unix sockets only nginx's workers (nobody:nogroup) and
# root can open, never a port Cain's own user could take while one is down (C1 plan 3.9).
# cain/run makes /run/cain-web/upstream (root:nogroup 0750); wait for it.
for _ in $(seq 1 120); do [ -d /run/cain-web/upstream ] && break; sleep 1; done
# nginx serves the panel and the Supervisor's health check (/health, config.yaml's watchdog URL).
# Should it not start (Cain 0.15.0, second round), that is logged with nginx's own words as the cause,
# after 3 tries 5 seconds apart, and raised as an alarm of its own (notice.sh tell nginx): with the
# Supervisor's Watchdog switch on, a health check that can't be reached restarts the App, and each
# start then says why. A start that works takes that alarm down.
nginx_why=""
for try in 1 2 3; do
  if nginx_out="$(nginx 2>&1)"; then nginx_why=""; break; fi
  nginx_why="$(printf '%s\n' "$nginx_out" | grep -v '^\s*$' | tail -n 1 | tr -d '\000-\037' | cut -c1-200)"
  bashio::log.error "nginx did not start (try $try of 3): ${nginx_why:-no reason given}"
  [ "$try" = 3 ] || sleep 5
done
if [ -n "$nginx_why" ]; then
  bashio::log.error "nginx did not start, so the panel and the Supervisor's health check are down: ${nginx_why:-no reason given}"
  /opt/cain/notice.sh tell nginx "${nginx_why:-no reason given}" || true
else
  /opt/cain/notice.sh clear panel >/dev/null 2>&1 || true
fi
unset nginx_out nginx_why try
umask 0007
rm -f /run/cain-web/upstream/ttyd.sock
exec ttyd --interface /run/cain-web/upstream/ttyd.sock --socket-owner root:nogroup --base-path /tty --writable \
  /opt/cain/terminal-attach.sh
