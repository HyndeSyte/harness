#!/usr/bin/env bashio
declare APP_EXIT_CODE=${1}
# The start was ended by SIGTERM (s6 passes 256 and the signal): the Supervisor is stopping the App,
# an owner's Stop, Restart or update from Home Assistant. Root keeps that stop as asked (probe/main.ts
# stop-asked, Cain 0.14.0), so the container start after it isn't counted as a restart; the run
# script's own TERM trap normally did so already, naming his run, and this is the same mark again
# (fifth round: the mark carries this container's id and the time; the next start takes it, and
# counts it only from this container and within 5 minutes). Up to 8 seconds, inside s6's finish
# limit (the Dockerfile's S6_KILL_FINISH_MAXTIME).
if [[ "${APP_EXIT_CODE}" -eq 256 ]] && [[ "${2:-}" -eq 15 ]]; then
  timeout 8 bun /opt/cain/probe/main.ts stop-asked >/dev/null 2>&1 || true
fi
if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
  bashio::log.warning "Cain stopped with exit code ${APP_EXIT_CODE}"
  # The outside heartbeat hears it at once (<heartbeat_url>/fail), when one is set. The URL is
  # never logged and never on a command line (a process listing shows those): curl reads it from
  # its config on stdin (-K -), https only, no redirects, 10 seconds at most. printf is bash's own.
  # Third round: -q first, so no curl config of the environment's is read; two retries; and no
  # xtrace for this block (a trace would print the URL), put back as it was after.
  case $- in *x*) hb_xtrace=1 ;; *) hb_xtrace= ;; esac
  { set +x; } 2>/dev/null
  hb="$(bashio::config 'heartbeat_url' 2>/dev/null || true)"
  if [[ "${hb}" =~ ^https://[A-Za-z0-9.-]+(:443)?(/[A-Za-z0-9._~%/-]*)?(\?[A-Za-z0-9._~%=\&-]*)?$ ]]; then
    hb_base="${hb%%\?*}"; hb_query="${hb:${#hb_base}}"
    printf 'url = "%s/fail%s"\n' "${hb_base%/}" "${hb_query}" \
      | curl -q -fsS -m 10 --retry 2 --max-redirs 0 --proto '=https' -o /dev/null --data-binary 'stopped on an error' -K - 2>/dev/null \
      && bashio::log.info "Told the outside heartbeat the App stopped on an error" \
      || bashio::log.warning "Couldn't tell the outside heartbeat the App stopped"
  fi
  unset hb hb_base hb_query
  if [ -n "${hb_xtrace}" ]; then set -x; fi
  unset hb_xtrace
  echo "${APP_EXIT_CODE}" > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi
