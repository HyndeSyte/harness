#!/usr/bin/with-contenv bashio
# ==============================================================================
# Prepare /data on first start, then run the session inside tmux so the
# terminal page can attach to it. Everything that must survive lives in /data:
# the Claude sign-in, the Discord token and allowlist, the plugin, the work folder.
# ==============================================================================
export HOME=/data TERM=xterm-256color LANG=C.UTF-8 LC_ALL=C.UTF-8
mkdir -p /data/work
# Cain's standing rules ship with the add-on, so an update always brings them.
cp /opt/cain/CLAUDE.md /data/work/CLAUDE.md
mkdir -p /data/work/.claude && cp /opt/cain/settings.json /data/work/.claude/settings.json
if ! claude plugin list 2>/dev/null | grep -q "discord@claude-plugins-official"; then
  bashio::log.info "Installing the Discord channel plugin"
  claude plugin marketplace add anthropics/claude-plugins-official || bashio::log.warning "Marketplace add failed"
  claude plugin install discord@claude-plugins-official --scope user || bashio::log.warning "Plugin install failed"
fi
bashio::log.info "Starting Cain"
tmux -u kill-session -t cain 2>/dev/null || true   # bashio runs with errexit
if ! tmux -u new-session -d -s cain -x 120 -y 40 /opt/cain/session.sh 2>/tmp/tmux.err; then
  bashio::log.error "tmux could not start: $(cat /tmp/tmux.err)"
  exit 1
fi
sleep 3
if ! tmux -u has-session -t cain 2>/dev/null; then
  bashio::log.error "Cain's session ended at once. Its last output:"
  tail -n 20 /data/session.log 2>/dev/null
  exit 1
fi
bashio::log.info "Cain is running"
# Which connectors Cain has, by name only (addresses removed), so the tools it
# must not use can be blocked by their exact names (/opt/cain/settings.json).
(
  sleep 30
  timeout 120 claude mcp list 2>&1 | sed -E 's#[a-z]+://[^ ]*#<address>#g' | head -n 40 \
    | while IFS= read -r line; do echo "[cain] connector: $line"; done
) &
# Check-ins: Cain moves open work at 7:10 AM, 12:30 PM and 5:30 PM without waiting
# for Dane. checkin.sh decides when, and only types into an idle session.
(
  while true; do /opt/cain/checkin.sh || true; sleep 30; done
) &
# The sign-in link is longer than a terminal line, and tmux breaks it, so a
# click opens a cut-off link. Keep the whole link on a page of its own:
# <Cain page>/signin. signin-url.sh joins the pieces.
printf '%s' '<!doctype html><meta name=viewport content="width=device-width"><p>No sign-in link on screen yet. Type /login in the Cain page, then reload this.</p>' > /tmp/signin.html
(
  while true; do
    screen=$(tmux -u capture-pane -p -J -t cain -S -400 2>/dev/null || true)
    url=$(printf '%s\n' "$screen" | /opt/cain/signin-url.sh || true)
    # Only while it is waiting for the code; afterwards the link is stale.
    if ! printf '%s\n' "$screen" | tail -n 30 | grep -Eqi 'paste.*code|oauth/authorize'; then
      url=''
      printf '%s' '<!doctype html><p>No sign-in waiting.</p>' > /tmp/signin.html
    fi
    # Yes/no facts for checking setup from outside, without showing the screen
    # (a token may be typed there): <Cain page>/status.
    flag() { if "$@" >/dev/null 2>&1; then echo true; else echo false; fi; }
    # access.json spreads allowFrom over several lines.
    paired() { tr -d ' \n' < /data/.claude/channels/discord/access.json | grep -q '"allowFrom":\["'; }
    last=$(printf '%s\n' "$screen" | tail -n 30)
    state=unknown
    # Only the bottom lines: Cain may talk about sign-in in its own replies.
    if printf '%s\n' "$last" | tail -n 12 | grep -Eqi 'run /login|token has expired|authentication_error|invalid api key|not logged in'; then state=login_needed
    elif printf '%s' "$last" | grep -Eqi 'paste.*code'; then state=waiting_for_code
    elif printf '%s' "$last" | grep -Eqi 'do you trust|trust the files'; then state=trust_prompt
    elif printf '%s' "$last" | grep -Eqi 'select login|login method|choose the text style|dark mode'; then state=first_run_menu
    elif printf '%s' "$last" | grep -Eqi 'for shortcuts|auto mode'; then state=ready
    fi
    printf '{"signed_in": %s, "discord_token": %s, "paired": %s, "allowlist": %s, "screen": "%s"}\n' \
      "$(flag test -s /data/.claude/.credentials.json)" \
      "$(flag grep -q '^DISCORD_BOT_TOKEN=.' /data/.claude/channels/discord/.env)" \
      "$(flag paired)" \
      "$(flag grep -Eq '"dmPolicy": *"allowlist"' /data/.claude/channels/discord/access.json)" \
      "$state" > /tmp/status.tmp && mv /tmp/status.tmp /tmp/status.json || true
    # When Claude's sign-in runs out, Cain can't answer, so the bot says so
    # itself, once, until Cain is ready again.
    if [ "$state" = login_needed ] && [ ! -f /data/alerted-login ]; then
      if /opt/cain/alert.sh "Cain can't answer: its Claude sign-in has expired. Open Cain in Home Assistant, tap Sign in to Claude, and paste the code in the box."; then
        touch /data/alerted-login
        bashio::log.warning "Sign-in expired; told the owner in Discord"
      else
        bashio::log.error "Sign-in expired, and the Discord alert failed"
      fi
    elif [ "$state" = ready ]; then
      rm -f /data/alerted-login
    fi
    if [ -n "$url" ]; then
      safe=$(printf '%s' "$url" | sed 's/&/\&amp;/g; s/"/%22/g; s/</%3C/g')
      printf '<!doctype html><meta name=viewport content="width=device-width"><p><a href="%s" target="_blank" rel="noopener" style="font-size:1.4em">Sign in to Claude</a></p><p>Then paste the code it gives you into the Cain page.</p>' "$safe" > /tmp/signin.tmp && mv /tmp/signin.tmp /tmp/signin.html || true
    fi
    sleep 2
  done
) &
# Stay in the foreground while the tmux session lives.
while tmux -u has-session -t cain 2>/dev/null; do sleep 10; done
bashio::log.warning "Cain's session ended. Its last output:"
tail -n 20 /data/session.log 2>/dev/null
exit 1
