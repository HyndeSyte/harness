#!/bin/sh
# git pre-push hook for a laptop: refuses a push to a branch of HyndeSyte/harness that
# this Claude Code session doesn't hold in Cain's record; pushes to anything else pass
# through. Install it for every repository at once by pointing git's global
# core.hooksPath at this folder (git config --global core.hooksPath <tools clone>/cain/tools),
# or copy it to one clone's .git/hooks/ and set CAIN_TOOLS to the tools clone.
# See Cain's DOCS.md, "Laptop sessions".
here=$(cd "$(dirname "$0")" && pwd)
tools="${CAIN_TOOLS:+$CAIN_TOOLS/cain/tools}"
exec bun "${tools:-$here}/record-prepush.ts" "$@"
