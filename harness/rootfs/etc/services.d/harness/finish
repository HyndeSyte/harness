#!/usr/bin/env bashio
# ==============================================================================
# If the controller exits with an error, stop the add-on so Home Assistant
# shows it as stopped (and the watchdog, if enabled, can restart it) rather
# than restarting it in a tight loop.
# ==============================================================================
declare APP_EXIT_CODE=${1}

if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
  bashio::log.warning "Harness stopped with exit code ${APP_EXIT_CODE}"
  echo "${APP_EXIT_CODE}" > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi

bashio::log.info "Harness restarting"
