#!/usr/bin/with-contenv bashio
# ==============================================================================
# The terminal page: ttyd on localhost only, behind nginx, which admits only
# Home Assistant's Ingress proxy. It attaches to the running session.
# ==============================================================================
export HOME=/data TERM=xterm-256color
nginx
exec ttyd --interface 127.0.0.1 --port 7681 --writable \
  bash -c 'until tmux has-session -t chief 2>/dev/null; do sleep 1; done; exec tmux attach -t chief'
